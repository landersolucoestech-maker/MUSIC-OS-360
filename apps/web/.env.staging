# MUSIC OS 360 Web — STAGING env template
# Copy to the hosting platform's env config and fill every <PLACEHOLDER>.
# Only VITE_* variables are allowed in the frontend.
# Never place private backend secrets, service-role keys, database URLs, JWT secrets,
# R2/S3 secrets, Redis URLs with passwords, Stripe secrets, or provider API keys here.

VITE_API_URL=<STAGING_API_URL>
VITE_SUPABASE_URL=https://<SUPABASE_STAGING_REF>.supabase.co
VITE_SUPABASE_ANON_KEY=<SUPABASE_ANON_PUBLIC_KEY>
# Must be false/absent in production — see apps/web/src/shared/lib/env.ts
# (ignored outside Vite dev mode regardless, but never set true here).
VITE_AUTH_DISABLED=false
VITE_DEV_AUTH_BYPASS=false
VITE_WS_ENABLED=true
VITE_APP_VERSION=0.0.1
VITE_POSTHOG_KEY=<POSTHOG_PUBLIC_KEY>
VITE_SENTRY_DSN=<SENTRY_PUBLIC_DSN>
VITE_DOCUSIGN_INTEGRATION_KEY=<DOCUSIGN_INTEGRATION_KEY>
VITE_DOCUSIGN_AUTH_BASE_URL=https://account-d.docusign.com
VITE_STRIPE_CONNECT_CLIENT_ID=<STRIPE_CONNECT_CLIENT_ID>
VITE_META_APP_ID=<META_APP_ID>
VITE_GOOGLE_CLIENT_ID=<GOOGLE_CLIENT_ID>
VITE_TIKTOK_CLIENT_KEY=<TIKTOK_CLIENT_KEY>
