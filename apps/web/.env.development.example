# MUSIC OS 360 Web — LOCAL DEVELOPMENT env template (placeholders only, safe to version)
# Copy to apps/web/.env.development (gitignored). Vite loads it automatically for `pnpm dev`
# (mode "development"); scripts/run-vite.mjs and `pnpm env:check` validate it before the server starts.
# Only VITE_* variables are allowed in the frontend.
# Never place private backend secrets, service-role keys, database URLs, JWT secrets,
# R2/S3 secrets, Redis URLs with passwords, Stripe secrets, or provider API keys here.
# Development must use the DEV Supabase project (ref rypnevnfipygyhysqpdo), the same one as the API.
# Same variable set as .env.staging / .env.production; cross-environment drift is checked by
# `node scripts/env-contract-census.mjs --check`.

# Host and port only, no path (the client appends /api/v1).
VITE_API_URL=http://localhost:3001
VITE_SUPABASE_URL=<DEV_SUPABASE_URL>
VITE_SUPABASE_ANON_KEY=<DEV_SUPABASE_ANON_KEY>
# Local-only switches: honored only when Vite runs in development mode (never in a build). Keep both false
# unless you intentionally browse without a login; the API needs AUTH_DISABLED=true for the first one.
VITE_AUTH_DISABLED=false
VITE_DEV_AUTH_BYPASS=false
# VITE_WS_ENABLED=true
# VITE_APP_VERSION=dev
# VITE_POSTHOG_KEY=<POSTHOG_KEY>
# VITE_SENTRY_DSN=<SENTRY_DSN>
# VITE_DOCUSIGN_INTEGRATION_KEY=<DOCUSIGN_INTEGRATION_KEY>
# VITE_DOCUSIGN_AUTH_BASE_URL=<DOCUSIGN_AUTH_BASE_URL>
# VITE_STRIPE_CONNECT_CLIENT_ID=<STRIPE_CONNECT_CLIENT_ID>
# VITE_META_APP_ID=<META_APP_ID>
# VITE_GOOGLE_CLIENT_ID=<GOOGLE_CLIENT_ID>
# VITE_TIKTOK_CLIENT_KEY=<TIKTOK_CLIENT_KEY>
