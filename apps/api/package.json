{
  "name": "@music-os-360/api",
  "version": "0.0.1",
  "description": "MUSIC OS 360 — NestJS Enterprise API",
  "private": true,
  "license": "UNLICENSED",
  "scripts": {
    "dev": "ts-node-dev --respawn --transpile-only -r tsconfig-paths/register src/main.ts",
    "start:dev": "ts-node-dev --respawn --transpile-only -r tsconfig-paths/register src/main.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/main.js",
    "lint": "eslint src --ext .ts",
    "typecheck": "tsc -p tsconfig.build.json --noEmit",
    "test": "jest --config jest.config.ts",
    "test:watch": "jest --config jest.config.ts --watch",
    "test:coverage": "jest --config jest.config.ts --coverage",
    "test:ci": "jest --config jest.config.ts --coverage --ci --forceExit --passWithNoTests",
    "test:e2e": "jest --config jest.e2e.config.ts",
    "db:migrate": "tsx scripts/db-ops.ts migrate",
    "db:migrate:application": "tsx scripts/db-ops.ts migrate:application",
    "db:rollback": "tsx scripts/db-ops.ts rollback",
    "db:seed": "tsx src/database/seeds/index.ts",
    "db:bootstrap:tenant-zero": "tsx src/database/bootstrap-tenant-zero.cli.ts",
    "db:reset": "tsx scripts/db-ops.ts reset",
    "db:check": "tsx scripts/db-ops.ts check",
    "db:check:application": "tsx scripts/db-ops.ts check:application",
    "verify:realtime-external": "tsx scripts/verify-realtime-external.ts",
    "db:generate": "tsx scripts/db-ops.ts generate",
    "db:seed:operational": "tsx scripts/db-ops.ts seed:operational",
    "verify:supabase": "tsx scripts/verify-supabase.ts",
    "verify:rls": "tsx scripts/verify-rls.ts",
    "verify:critical-rls": "tsx scripts/verify-critical-rls.ts",
    "verify:migrations": "tsx scripts/db-ops.ts check",
    "verify:canonical-order": "tsx scripts/verify-canonical-column-order.ts",
    "verify:tenant-isolation": "tsx scripts/verify-tenant-isolation.ts",
    "verify:contract-service-types": "tsx scripts/verify-contract-service-types-crud.ts",
    "smoke-test": "tsx scripts/smoke-test.ts",
    "provision": "pnpm run verify:supabase && pnpm run verify:rls && pnpm run verify:tenant-isolation",
    "dump:sql": "tsx scripts/dump-migrations-sql.ts",
    "storage:e2e": "tsx scripts/storage-e2e.ts",
    "rbac:shadow:run": "tsx test/rbac-shadow-harness/rbac-shadow-harness.runner.ts",
    "rbac:shadow:go-no-go": "tsx scripts/rbac-shadow-go-no-go.ts",
    "validate:i18n": "tsx scripts/validate-i18n.ts",
    "reports:smoke": "tsx scripts/reports-smoke.ts",
    "rbac:readiness": "tsx scripts/rbac-shadow-readiness.ts",
    "verify:signup-provisioning": "tsx scripts/verify-signup-provisioning.ts",
    "verify:no-inline-body": "tsx scripts/verify-no-inline-body.ts",
    "verify:production-flags": "tsx scripts/verify-production-flags.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.95.2",
    "@aws-sdk/client-s3": "^3.1045.0",
    "@aws-sdk/s3-request-presigner": "^3.1045.0",
    "@bull-board/api": "^7.0.0",
    "@bull-board/express": "^7.0.0",
    "@bull-board/nestjs": "^7.0.0",
    "@google/generative-ai": "^0.24.1",
    "@music-os-360/ai-skills": "workspace:*",
    "@music-os-360/types": "workspace:*",
    "@nestjs/bullmq": "^10.2.3",
    "@nestjs/common": "^10.3.0",
    "@nestjs/config": "^3.2.0",
    "@nestjs/core": "^10.3.0",
    "@nestjs/event-emitter": "^3.1.0",
    "@nestjs/platform-express": "^10.3.0",
    "@nestjs/swagger": "^7.3.0",
    "@nestjs/terminus": "^10.2.3",
    "@nestjs/typeorm": "^10.0.2",
    "@sentry/node": "^10.53.1",
    "@supabase/supabase-js": "^2.105.4",
    "@types/pg": "^8.20.0",
    "bullmq": "^5.76.8",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.1",
    "compression": "^1.7.4",
    "express": "^5.2.1",
    "helmet": "^7.1.0",
    "ioredis": "^5.10.1",
    "jsonwebtoken": "^9.0.3",
    "jwks-rsa": "^4.0.1",
    "openai": "^6.37.0",
    "pg": "^8.20.0",
    "posthog-node": "^5.34.1",
    "prom-client": "^15.1.3",
    "reflect-metadata": "^0.2.1",
    "rxjs": "^7.8.1",
    "stripe": "^22.1.1",
    "tsconfig-paths": "^4.2.0",
    "typeorm": "^0.3.31",
    "uuid": "^11.1.1",
    "xlsx": "^0.18.5",
    "zod": "^3.22.4"
  },
  "devDependencies": {
    "@nestjs/testing": "^10.4.22",
    "@types/compression": "^1.7.5",
    "@types/express": "^4.17.21",
    "@types/jest": "^30.0.0",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^20.11.0",
    "@types/supertest": "^7.2.0",
    "jest": "^30.4.2",
    "supertest": "^7.2.2",
    "ts-jest": "^29.4.9",
    "ts-node-dev": "^2.0.0",
    "tsx": "^4.20.5",
    "typescript": "^5.3.3"
  }
}
