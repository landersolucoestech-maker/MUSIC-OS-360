# ══════════════════════════════════════════════
# MUSIC OS 360 API — LOCAL DEVELOPMENT env template (placeholders only, safe to version)
# ══════════════════════════════════════════════
# Copy to apps/api/.env.development (gitignored) and fill the real DEV values locally. Never commit it.
# Loader: src/main.ts (and src/database/datasource.ts) read apps/api/.env.development first, then
# <cwd>/.env.development; variables already present in process.env always win. In staging and production the
# file does not exist and the variables come from the hosting platform (see .env.staging / .env.production).
#
# Development must use the DEV Supabase project (ref rypnevnfipygyhysqpdo). NEVER point it at the staging
# or production ref: env.schema.ts and `pnpm env:check` refuse a ref that belongs to another environment.
# Validation: every variable below is validated by apps/api/src/core/config/env.schema.ts.
#
# Same variable set as .env.staging / .env.production. Development differences:
#   - variables the schema requires only in production are OPTIONAL here (commented);
#   - the dev-only bypass switches at the end exist only in development (forbidden elsewhere).
# Cross-environment drift is checked by `node scripts/env-contract-census.mjs --check`.

NODE_ENV=development
PORT=3001

# ── PostgreSQL ────────────────────────────────────────
# [REQUIRED locally] DEV project connection string (pooler or direct), %-encoded password
DATABASE_URL=postgresql://postgres.rypnevnfipygyhysqpdo:Saozinha123@aws-0-us-east-1.pooler.supabase.com:5432/postgres
# Optional: direct (non-pooled) URL for migrations
# DIRECT_DATABASE_URL=postgresql://postgres.rypnevnfipygyhysqpdo:Saozinha123@aws-0-us-east-1.pooler.supabase.com:5432/postgres
# "false" only for a local PostgreSQL without TLS (accepted values: true | false)
# DB_SSL=false
# DB_POOL_MAX=20
# DB_POOL_MIN=1
# DB_POOL_CONNECTION_TIMEOUT_MS=15000

# ── Redis ─────────────────────────────────────────
# Optional locally (queues stay idle without it)
# REDIS_URL=redis://localhost:6379
# REDIS_QUEUE_URL=redis://localhost:6379

# ── RLS / tenant session context ───────────────────
# DATABASE_SESSION_CONTEXT_ENABLED=false
# APP_DATABASE_URL=<DEV_APP_DATABASE_URL>

# ── RBAC persisted authority ──────────────────────
# RBAC_PERSISTED_AUTHORITY=SHADOW

# ── Supabase Auth (DEV project) ───────────────────
# [REQUIRED locally] Confirm this is the DEV project (ref rypnevnfipygyhysqpdo)
SUPABASE_URL=<DEV_SUPABASE_URL>
SUPABASE_ANON_KEY=<DEV_SUPABASE_ANON_KEY>
# SUPABASE_SERVICE_ROLE_KEY=<DEV_SUPABASE_SERVICE_ROLE_KEY>

# ── Encryption (AES-256-GCM) ──────────────────────
# Optional locally: development and test accept the documented all-zero default; staging and production reject it.
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# ENCRYPTION_KEY=<64_HEX_CHARS>

# ── App URLs ──────────────────────────────────────
# APP_URL=http://localhost:5173
# FRONTEND_URL=http://localhost:5173
CORS_ORIGINS=http://localhost:5173

# ── Cloudflare R2 ─────────────────────────────────
# R2_ACCOUNT_ID=<R2_ACCOUNT_ID>
# R2_ACCESS_KEY=<R2_ACCESS_KEY>
# R2_SECRET_KEY=<R2_SECRET_KEY>
# R2_BUCKET_NAME=<R2_BUCKET_NAME>
# R2_PUBLIC_URL=<R2_PUBLIC_URL>

# ── Stripe Billing ────────────────────────────────
# Plans and prices come from the billing_plans table, not from the environment.
# STRIPE_SECRET_KEY=<STRIPE_SECRET_KEY>
# STRIPE_WEBHOOK_SECRET=<STRIPE_WEBHOOK_SECRET>

# ── Email transactional ───────────────────────────
# RESEND_API_KEY=<RESEND_API_KEY>
# RESEND_FROM_EMAIL=<RESEND_FROM_EMAIL>

# ── Autentique digital signature ──────────────────
# AUTENTIQUE_WEBHOOK_SECRET=<AUTENTIQUE_WEBHOOK_SECRET>

# ── Sentry observability ──────────────────────────
# SENTRY_DSN=<SENTRY_DSN>
# SENTRY_RELEASE=<SENTRY_RELEASE>

# ── PostHog analytics ─────────────────────────────
# POSTHOG_API_KEY=<POSTHOG_API_KEY>
# POSTHOG_HOST=<POSTHOG_HOST>

# ── Operational dashboards ────────────────────────
# Outside staging/production the queue dashboard falls back to a local-only basic-auth default; set both to override.
# ADMIN_QUEUES_USER=<ADMIN_QUEUES_USER>
# ADMIN_QUEUES_PASS=<ADMIN_QUEUES_PASS>
# METRICS_TOKEN=<METRICS_TOKEN>

# ── External webhooks ─────────────────────────────
# EXTERNAL_DATA_WEBHOOK_SECRET=<EXTERNAL_DATA_WEBHOOK_SECRET>

# ── Music integrations (optional per tenant) ──────
# ACRCLOUD_HOST=<ACRCLOUD_HOST>
# ACRCLOUD_ACCESS_KEY=<ACRCLOUD_ACCESS_KEY>
# ACRCLOUD_ACCESS_SECRET=<ACRCLOUD_ACCESS_SECRET>
# SPOTIFY_CLIENT_ID=<SPOTIFY_CLIENT_ID>
# SPOTIFY_CLIENT_SECRET=<SPOTIFY_CLIENT_SECRET>
# SPOTIFY_REDIRECT_URI=<SPOTIFY_REDIRECT_URI>
# SPOTIFY_OAUTH_STATE_SECRET=<SPOTIFY_OAUTH_STATE_SECRET>
# YOUTUBE_API_KEY=<YOUTUBE_API_KEY>
# META_APP_ID=<META_APP_ID>
# META_APP_SECRET=<META_APP_SECRET>
# META_REDIRECT_URI=<META_REDIRECT_URI>
# TIKTOK_CLIENT_KEY=<TIKTOK_CLIENT_KEY>
# TIKTOK_CLIENT_SECRET=<TIKTOK_CLIENT_SECRET>
# TIKTOK_REDIRECT_URI=<TIKTOK_REDIRECT_URI>
# SOUNDCLOUD_CLIENT_ID=<SOUNDCLOUD_CLIENT_ID>
# GOOGLE_CLIENT_ID=<GOOGLE_CLIENT_ID>
# GOOGLE_CLIENT_SECRET=<GOOGLE_CLIENT_SECRET>
# GOOGLE_ADS_CLIENT_ID=<GOOGLE_ADS_CLIENT_ID>
# GOOGLE_ADS_CLIENT_SECRET=<GOOGLE_ADS_CLIENT_SECRET>
# GOOGLE_ADS_REDIRECT_URI=<GOOGLE_ADS_REDIRECT_URI>

# ── AI Providers ──────────────────────────────────
# ANTHROPIC_API_KEY=<ANTHROPIC_API_KEY>
# OPENAI_API_KEY=<OPENAI_API_KEY>
# GOOGLE_AI_API_KEY=<GOOGLE_AI_API_KEY>

# ── Idempotency ───────────────────────────────────
# IDEMPOTENCY_TTL_HOURS=24

# ── Other validated variables (optional) ──────────
# Soundcharts audience metrics (backend only, client_credentials)
# SOUNDCHARTS_CLIENT_ID=<SOUNDCHARTS_CLIENT_ID>
# SOUNDCHARTS_CLIENT_SECRET=<SOUNDCHARTS_CLIENT_SECRET>
# WhatsApp Cloud API webhook verify token (one per Meta app)
# WHATSAPP_WEBHOOK_VERIFY_TOKEN=<WHATSAPP_WEBHOOK_VERIFY_TOKEN>
# DocuSign Connect HMAC key (at least 24 characters)
# DOCUSIGN_WEBHOOK_SECRET=<DOCUSIGN_WEBHOOK_SECRET>
# Platform contact form recipient
# PLATFORM_CONTACT_RECIPIENT_EMAIL=<PLATFORM_CONTACT_RECIPIENT_EMAIL>
# Redis by parts, as an alternative to REDIS_URL
# REDIS_HOST=localhost
# REDIS_PORT=6379
# REDIS_PASSWORD=<REDIS_PASSWORD>
# Deploy-platform build identifier shown by /health
# BUILD_SHA=<BUILD_SHA>
# "true" trusts X-Forwarded-For behind a known proxy only
# RATE_LIMIT_TRUST_PROXY=false
# "false" is the kill switch that makes the role writer emit the legacy form
# RBAC_CANONICAL_ROLE_WRITE=true
# Registry adapters stay disabled unless exactly "true"
# REGISTRY_PARTNER_API_ENABLED=false
# REGISTRY_PORTAL_RPA_ENABLED=false

# ── Dev-only bypass switches (NEVER set in staging/production) ────────────────
# Each of these makes the API refuse to boot when NODE_ENV is staging/production, and
# `verify:production-flags` fails the release if any is "true" there. Template default: all off.
# AUTH_DISABLED=false
# DEV_SOCIAL_METRICS_MOCK=false
# DEV_AUTH_ENDPOINT_ENABLED=false
# DEV_AUTH_EMAIL=<THROW_AWAY_DEV_ACCOUNT_EMAIL>
# DEV_AUTH_PASSWORD=<THROW_AWAY_DEV_ACCOUNT_PASSWORD>
# DEV_TENANT_ID=<UUID>
# DEV_ORG_ID=<UUID>
