# ════════════════════════════════════════════════════════════════════════════════
# MUSIC OS 360 — STAGING env template
# ════════════════════════════════════════════════════════════════════════════════
# Copy to the staging host / platform secrets manager and fill EVERY value
# marked [REQUIRED-REAL]. Same variable set as .env.production (staging runs
# identical app code against staging infra) — see env.schema.ts for the
# Supabase ref this environment must use: jjnnjnxjkqipgqebijen. NEVER point
# staging at the production ref (sxmfeocztlztvpdnxayk) or the dev ref
# (rypnevnfipygyhysqpdo).
#
# Validation: NODE_ENV=staging node dist/bootstrap.cjs MUST boot without
# "Invalid environment variables" errors.

NODE_ENV=staging
PORT=3001

# ── PostgreSQL ────────────────────────────────────────────────────────────────
# [REQUIRED-REAL] Supabase pooler URL with %-encoded password special chars
DATABASE_URL=postgresql://<DB_USER>:<DB_PASSWORD>@<DB_HOST>:5432/<DB_NAME>
# Optional but recommended: direct (non-pooled) URL for migrations
DIRECT_DATABASE_URL=postgresql://<DB_USER>:<DB_PASSWORD>@<DB_HOST>:5432/<DB_NAME>
# Production must use SSL (default). Set to "false" only for self-hosted PG without TLS.
DB_SSL=true
DB_POOL_MAX=20
DB_POOL_MIN=2
DB_POOL_CONNECTION_TIMEOUT_MS=15000

# ── Redis ─────────────────────────────────────────────────────────────────────
# [REQUIRED-REAL] Upstash rediss:// URL or self-hosted Redis — never Railway
# (forbidden in this project).
REDIS_URL=redis://<REDIS_HOST>:6379
REDIS_QUEUE_URL=redis://<REDIS_HOST>:6379

# ── RLS / tenant session context (DBCTX-01) ──────────────────────────────────
# [REQUIRED-REAL] The default ("false") is silent and disables per-tenant DB
# session isolation. validateEnv() now hard-fails boot in production if this
# is left undeclared, set to "false", or "true" without APP_DATABASE_URL below.
DATABASE_SESSION_CONTEXT_ENABLED=true
# [REQUIRED-REAL when the line above is "true"] Dedicated NOBYPASSRLS app role
# connection string (musicos_app). Without it, the DataSource silently falls
# back to DATABASE_URL (bypassrls) even with the flag "true" above.
APP_DATABASE_URL=postgresql://musicos_app:<APP_DB_PASSWORD>@<DB_HOST>:5432/<DB_NAME>

# ── RBAC persisted authority (RBAC-SHADOW-01) ────────────────────────────────
# [REQUIRED-REAL] The default ("SHADOW") means real authorization still runs on
# the legacy engine. validateEnv() now hard-fails boot in production unless this
# is explicitly declared. Set to "ON" once test/rbac-shadow-harness has approved
# the promotion (pnpm rbac:shadow:go-no-go → APPROVED). "OFF" is always rejected.
RBAC_PERSISTED_AUTHORITY=ON
# [TEMPORARY ONLY] Only if RBAC_PERSISTED_AUTHORITY must stay "SHADOW" in
# production while the harness rollout is still in progress — never leave this
# "true" permanently, remove it the moment the flag above is promoted to "ON".
# ALLOW_RBAC_SHADOW_IN_PRODUCTION=true

# ── Supabase Auth ─────────────────────────────────────────────────────────────
# [REQUIRED-REAL] Confirm this is the STAGING project (ref jjnnjnxjkqipgqebijen), not dev/prod
SUPABASE_URL=https://<SUPABASE_URL>
SUPABASE_ANON_KEY=<SUPABASE_ANON_KEY>
SUPABASE_SERVICE_ROLE_KEY=<SUPABASE_SERVICE_ROLE_KEY>

# ── Encryption (AES-256-GCM) ─────────────────────────────────────────────────
# [REQUIRED-REAL] Generate fresh: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# MUST be 64 hex chars and NOT all-zero (env.schema rejects)
ENCRYPTION_KEY=<ENCRYPTION_KEY>

# ── App URLs (no localhost allowed in production) ────────────────────────────
# [REQUIRED-REAL] env.schema rejects localhost/127.0.0.1 in production
APP_URL=https://<APP_URL>
FRONTEND_URL=https://<FRONTEND_URL>
CORS_ORIGINS=https://app.musicos360.com

# ── Cloudflare R2 ────────────────────────────────────────────────────────────
# [REQUIRED-REAL — P0-02] Public bucket URL. env.schema rejects "pub-xxx" or "placeholder"
R2_ACCOUNT_ID=<R2_ACCOUNT_ID>
R2_ACCESS_KEY=<R2_ACCESS_KEY>
R2_SECRET_KEY=<R2_SECRET_KEY>
R2_BUCKET_NAME=musicos360
R2_PUBLIC_URL=https://<R2_PUBLIC_URL>

# ── Stripe Billing ───────────────────────────────────────────────────────────
# Plans/prices do NOT come from env — the primary source is the billing_plans table,
# synced with Stripe (Product+Price) by the Admin Panel. STRIPE_PRICE_*
# was removed — no code reads these variables.
STRIPE_SECRET_KEY=<STRIPE_SECRET_KEY>
# [REQUIRED-REAL] env.schema rejects if STRIPE_SECRET_KEY set without STRIPE_WEBHOOK_SECRET
STRIPE_WEBHOOK_SECRET=<STRIPE_WEBHOOK_SECRET>

# ── Email transactional ──────────────────────────────────────────────────────
# [REQUIRED-REAL — P0-03] Resend API key (re_<random>); env.schema requires in prod
RESEND_API_KEY=<RESEND_API_KEY>
RESEND_FROM_EMAIL=noreply@musicos360.com.br

# ── Autentique digital signature ─────────────────────────────────────────────
# [REQUIRED-REAL — P0-01] ≥24 chars from Autentique webhook config; env.schema rejects shorter
AUTENTIQUE_WEBHOOK_SECRET=<AUTENTIQUE_WEBHOOK_SECRET>

# ── Sentry observability ─────────────────────────────────────────────────────
# [REQUIRED-REAL — P0-04] Real DSN. Placeholder pattern detected by isPlaceholder() and disables Sentry.
SENTRY_DSN=<SENTRY_DSN>
SENTRY_RELEASE=<SENTRY_RELEASE>
# In production tracesSampleRate=0.1, profilesSampleRate=0.05 (configured in code)

# ── PostHog analytics ────────────────────────────────────────────────────────
# [REQUIRED-REAL — P0-05] Real phc_ key. Placeholder pattern detected and disables PostHog.
POSTHOG_API_KEY=<POSTHOG_API_KEY>
POSTHOG_HOST=https://<POSTHOG_HOST>

# ── Operational dashboards ───────────────────────────────────────────────────
# [REQUIRED-REAL] BullBoard /admin/queues HTTP basic-auth. Without these, dashboard disabled.
ADMIN_QUEUES_USER=<ADMIN_QUEUES_USER>
ADMIN_QUEUES_PASS=<ADMIN_QUEUES_PASS>
# [RECOMMENDED] Token for /metrics scrape (otherwise endpoint is public if reachable)
METRICS_TOKEN=<METRICS_TOKEN>

# ── External webhooks ────────────────────────────────────────────────────────
EXTERNAL_DATA_WEBHOOK_SECRET=<EXTERNAL_DATA_WEBHOOK_SECRET>

# ── Music integrations (optional per tenant — set if used) ───────────────────
# ACRCloud — fix mismatch: code reads ACRCLOUD_ACCESS_SECRET (P0-B7 follow-up)
ACRCLOUD_HOST=https://<ACRCLOUD_HOST>
ACRCLOUD_ACCESS_KEY=<ACRCLOUD_ACCESS_KEY>
ACRCLOUD_ACCESS_SECRET=<ACRCLOUD_ACCESS_SECRET>

# Spotify
SPOTIFY_CLIENT_ID=<SPOTIFY_CLIENT_ID>
SPOTIFY_CLIENT_SECRET=<SPOTIFY_CLIENT_SECRET>
SPOTIFY_REDIRECT_URI=https://<SPOTIFY_REDIRECT_URI>
SPOTIFY_OAUTH_STATE_SECRET=<SPOTIFY_OAUTH_STATE_SECRET>

# YouTube
YOUTUBE_API_KEY=<YOUTUBE_API_KEY>

# Meta / Instagram
META_APP_ID=<META_APP_ID>
META_APP_SECRET=<META_APP_SECRET>
META_REDIRECT_URI=https://<META_REDIRECT_URI>

# TikTok
TIKTOK_CLIENT_KEY=<TIKTOK_CLIENT_KEY>
TIKTOK_CLIENT_SECRET=<TIKTOK_CLIENT_SECRET>
TIKTOK_REDIRECT_URI=https://<TIKTOK_REDIRECT_URI>

# SoundCloud
SOUNDCLOUD_CLIENT_ID=<SOUNDCLOUD_CLIENT_ID>

# Google (generic OAuth exchange — corp_youtube/google_business fallback) + Google Ads
GOOGLE_CLIENT_ID=<GOOGLE_CLIENT_ID>
GOOGLE_CLIENT_SECRET=<GOOGLE_CLIENT_SECRET>
GOOGLE_ADS_CLIENT_ID=<GOOGLE_ADS_CLIENT_ID>
GOOGLE_ADS_CLIENT_SECRET=<GOOGLE_ADS_CLIENT_SECRET>
GOOGLE_ADS_REDIRECT_URI=https://<GOOGLE_ADS_REDIRECT_URI>

# AI Providers
ANTHROPIC_API_KEY=<ANTHROPIC_API_KEY>
OPENAI_API_KEY=<OPENAI_API_KEY>
GOOGLE_AI_API_KEY=<GOOGLE_AI_API_KEY>

# ── Idempotency ───────────────────────────────────────────────────────────────
IDEMPOTENCY_TTL_HOURS=24
