# Build output
dist/
build/

# Playwright test artifacts
test-results/
playwright-report/

# Local scratch/state directories
.local/

# Dependencies
node_modules/

# Monorepo / task runner cache
.turbo/

# Local machine/tool caches (not project state)
.config/

# Environment files and secret backups
.env
.env.*
!.env.*.example
# Root .env.staging / .env.production (Part 82): renamed from the old
# .env.staging.example / .env.example — placeholders only, safe to version.
# Real secrets are injected outside Git (CI/CD secrets, deployment platform),
# never filled into these files. .env.development stays gitignored (real
# local secrets) — no negation for it.
!/.env.staging
!/.env.production
# apps/api and apps/web mirror the same root pattern: .env.staging/.env.production
# are placeholder-only templates (<DB_USER>, <ENCRYPTION_KEY>, ...) documenting
# required env vars per environment, safe to version. .env.development stays
# gitignored everywhere (real local secrets) — no negation for it. Formerly
# apps/api/.env.production.template + apps/api/.env.example + .env.dev.example
# (consolidated into the two names below); apps/web/.env.example likewise
# folded into apps/web/.env.production.
!apps/api/.env.staging
!apps/api/.env.production
!apps/web/.env.staging
!apps/web/.env.production
.env.backup*
.env.*.backup
*.env.bak
*.env.backup
*.env.secret
*.env.secrets

# Logs
*.log
npm-debug.log*
pnpm-debug.log*
yarn-debug.log*
yarn-error.log*

# OS
.DS_Store
Thumbs.db

# TypeScript
*.tsbuildinfo

# Editor / IDE
.vscode/
.idea/
*.swp
*.swo

# Test / coverage
coverage/
.vitest-cache/

# Database / generated temporary artifacts
*.dump
*.bak
*.tmp
*-temp.sql
*.sqlite
*.sqlite3

# Misc generated
*.local
public/mockServiceWorker.js

# Local Claude Code tooling config (not versioned)
.claude/settings.local.json

# RBAC shadow harness — local ES256 signing key (never commit)
supabase/signing_keys.json

# Local secrets directory — protected today only by a nested .gitignore; belt-and-suspenders at root
.secrets/

# Local artifacts — DB dumps, validation screenshots and harness outputs (never commit)
backups/
apps/api/backups/
.validation-shots/
apps/web/.validation-shots*
apps/api/test/rbac-shadow-harness/out/
