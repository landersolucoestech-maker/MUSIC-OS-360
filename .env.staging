# ─────────────────────────────────────────────────────────────────────────────
# .env.staging — disposable staging environment
#
# Placeholders only — do NOT add real secrets to this versioned file.
# Real values of the disposable Supabase BRANCH/PROJECT (NEVER from production) are
# injected outside Git (e.g. GitHub Actions secrets, provider env vars).
#
# IMPORTANT — the scripts do NOT use a single prefix. Each one reads different names.
# This file lists the STAGING_* variables as the source of truth and, next to
# each one, which canonical name you must export when running each script
# (see docs/runbooks/staging-to-production.md and docs/STAGING_ARCHITECTURE.md).
# ─────────────────────────────────────────────────────────────────────────────

# ── Environment ──────────────────────────────────────────────────────────────────
NODE_ENV=staging

# ── Environment URLs ─────────────────────────────────────────────────────────
STAGING_API_URL=https://<STAGING_API_URL>

# ── Supabase (disposable BRANCH) ────────────────────────────────────────────
STAGING_SUPABASE_URL=https://<STAGING_SUPABASE_URL>
STAGING_SUPABASE_ANON_KEY=<STAGING_SUPABASE_ANON_KEY>
STAGING_SUPABASE_SERVICE_ROLE_KEY=<STAGING_SUPABASE_SERVICE_ROLE_KEY>

# ── Database (disposable BRANCH) ───────────────────────────────────────────────
STAGING_DATABASE_URL=postgresql://<DB_USER>:<DB_PASSWORD>@<DB_HOST>:5432/<DB_NAME>
STAGING_APP_DATABASE_URL=postgresql://<DB_USER>:<DB_PASSWORD>@<DB_HOST>:5432/<DB_NAME>
# A Supabase branch normally requires SSL.
DB_SSL=true

# ── Acceptance-test tenants (fill in after seeding 3 tenants) ─────────────────
STAGING_TENANT_IDS=<STAGING_TENANT_IDS>
RBAC_HARNESS_TENANT_A=<RBAC_HARNESS_TENANT_A>
RBAC_HARNESS_TENANT_B=<RBAC_HARNESS_TENANT_B>
RBAC_HARNESS_TENANT_C=<RBAC_HARNESS_TENANT_C>

# ── Credentials of the acceptance-test users (password-grant harness) ─────────
# The password may be a single one (PROVISION_PASSWORD in the provisioning script) and reused here.
RBAC_HARNESS_OWNER_EMAIL=<RBAC_HARNESS_OWNER_EMAIL>
RBAC_HARNESS_OWNER_PASSWORD=<RBAC_HARNESS_OWNER_PASSWORD>
RBAC_HARNESS_ADMIN_EMAIL=<RBAC_HARNESS_ADMIN_EMAIL>
RBAC_HARNESS_ADMIN_PASSWORD=<RBAC_HARNESS_ADMIN_PASSWORD>
RBAC_HARNESS_MANAGER_EMAIL=<RBAC_HARNESS_MANAGER_EMAIL>
RBAC_HARNESS_MANAGER_PASSWORD=<RBAC_HARNESS_MANAGER_PASSWORD>
RBAC_HARNESS_EDITOR_EMAIL=<RBAC_HARNESS_EDITOR_EMAIL>
RBAC_HARNESS_EDITOR_PASSWORD=<RBAC_HARNESS_EDITOR_PASSWORD>
RBAC_HARNESS_VIEWER_EMAIL=<RBAC_HARNESS_VIEWER_EMAIL>
RBAC_HARNESS_VIEWER_PASSWORD=<RBAC_HARNESS_VIEWER_PASSWORD>
# optional (preferred for 7-role coverage):
RBAC_HARNESS_ACCOUNTING_EMAIL=<RBAC_HARNESS_ACCOUNTING_EMAIL>
RBAC_HARNESS_ACCOUNTING_PASSWORD=<RBAC_HARNESS_ACCOUNTING_PASSWORD>
RBAC_HARNESS_ARTIST_EMAIL=<RBAC_HARNESS_ARTIST_EMAIL>
RBAC_HARNESS_ARTIST_PASSWORD=<RBAC_HARNESS_ARTIST_PASSWORD>

# ── Harness targets (optional; defaults in parentheses) ───────────────────
RBAC_HARNESS_TARGET_REQUESTS=1000
RBAC_HARNESS_TARGET_ENDPOINTS=10
RBAC_HARNESS_TARGET_RESOURCES=5
RBAC_HARNESS_TARGET_ROLES=5
RBAC_HARNESS_TARGET_TENANTS=3

# ── R2 storage (may reuse the current bucket or a staging prefix) ─────────
R2_ACCOUNT_ID=<R2_ACCOUNT_ID>
R2_ACCESS_KEY=<R2_ACCESS_KEY>
R2_SECRET_KEY=<R2_SECRET_KEY>
R2_BUCKET_NAME=<R2_BUCKET_NAME>
R2_PUBLIC_URL=https://<R2_PUBLIC_URL>

# ── Transactional email (Resend) ──────────────────────────────────────────────
# STAGING-01: with NODE_ENV=staging, MailService only sends to the domains
# listed here — protects against real sending during manual tests.
RESEND_API_KEY=<RESEND_API_KEY>
RESEND_FROM_EMAIL=staging@musicos360.com.br
STAGING_MAIL_ALLOWLIST_DOMAINS=example.com

# ── Observability ──────────────────────────────────────────────────────────
SENTRY_DSN=<SENTRY_DSN>

# ── Operational confirmations (security gates of the scripts) ───────────────
# PROVISION_CONFIRM=YES        # required by provision-staging-rbac-users.ts
# PROVISION_PASSWORD=<senha>   # single password for the 21 users (optional)
