{
  "name": "engineering-change",
  "description": "A planned feature or change to existing code: discovery, requirements, scope lock, implementation, independent review, verification and closure.",
  "phases": [
    {
      "id": "discovery",
      "requiredAgents": [
        "repo-inspector",
        "codebase-explorer"
      ],
      "requiredSkills": [
        "repo-inspect",
        "discover"
      ],
      "requiredEvidence": [
        "discovery-record"
      ],
      "gates": [],
      "dependsOn": []
    },
    {
      "id": "requirements",
      "requiredAgents": [
        "requirements-validator",
        "acceptance-criteria-engineer"
      ],
      "requiredSkills": [],
      "requiredEvidence": [
        "requirement-records"
      ],
      "gates": [],
      "dependsOn": [
        "discovery"
      ]
    },
    {
