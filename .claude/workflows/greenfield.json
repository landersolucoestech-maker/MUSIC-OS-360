{
  "name": "greenfield",
  "description": "A new project with no existing product code to audit — repo-intelligence still runs (to confirm it really is empty/new) but most specialist review phases are skipped since there's nothing to review yet; the workflow is mostly requirements + architecture-forward implementation.",
  "phases": [
    {
      "id": "discovery",
      "requiredAgents": [
        "repository-orchestrator"
      ],
      "requiredSkills": [],
      "requiredEvidence": [],
      "gates": [],
      "dependsOn": []
    },
    {
      "id": "requirements",
      "requiredAgents": [
        "requirements-analyst"
      ],
      "requiredSkills": [],
      "requiredEvidence": [],
      "gates": [],
      "dependsOn": [
        "discovery"
      ]
    },
    {
      "id": "architecture-design",
      "requiredAgents": [
        "architecture-reviewer"
      ],
      "requiredSkills": [
        "cross-layer-impact"
      ],
      "requiredEvidence": [],
      "gates": [],
      "dependsOn": [
        "requirements"
      ]
    },
    {
      "id": "implementation",
      "requiredAgents": [
        "implementation-engineer"
      ],
      "requiredSkills": [
        "evidence-collection"
