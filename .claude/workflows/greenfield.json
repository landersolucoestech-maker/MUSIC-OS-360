        "completion"
      ],
      "approvalRequired": false,
      "dependsOn": [
        "implementation"
      ]
    }
  ],
  "recoveryPath": "mission-recovery skill; a greenfield mission has minimal state to lose since nothing existed before it",
  "completionConditions": [
    "completion-gate.mjs PASS",
    "no undisposed CRITICAL/HIGH finding"
  ],
  "match": {
    "keywords": [
      "greenfield",
      "new module",
      "from scratch",
      "new service"
    ],
    "examples": [
      "Create a new module from scratch"
    ]
  }
}
