        "requirements"
      ]
    },
    {
      "id": "findings-inventory",
      "requiredAgents": [
        "architecture-reviewer",
        "backend-reviewer",
        "frontend-reviewer",
        "security-reviewer"
      ],
      "requiredEvidence": [],
      "gates": [],
      "dependsOn": [
