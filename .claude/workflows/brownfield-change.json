      "requiredAgents": [
        "repo-intelligence"
      ],
      "requiredEvidence": [],
      "gates": [],
      "dependsOn": []
    },
    {
      "id": "requirements",
      "requiredAgents": [
        "requirements-analyst"
      ],
      "requiredEvidence": [],
      "gates": [],
      "dependsOn": [
        "discovery"
      ]
    },
    {
      "id": "impact-classification",
      "requiredAgents": [],
