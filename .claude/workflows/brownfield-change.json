  "recoveryPath": "mission-recovery skill; resume from .claude/ops/state.json rather than restarting discovery",
  "completionConditions": [
    "completion-gate.mjs PASS",
    "no undisposed CRITICAL/HIGH finding",
    "git-auditor evidence PASS"
