{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://engineering-os/contracts/pack-registry.schema.json",
  "title": "PackRegistry",
  "description": "Derived index of the pack, generated by .claude/runtime/build-pack-registry.mjs from the agent and skill markdown files (the single source of truth) and verified for drift by validate-pack-contracts.mjs. Never edited by hand.",
  "type": "object",
  "required": [
    "generatedFrom",
    "counts",
    "agents",
    "skills"
  ],
  "properties": {
    "generatedFrom": {
      "type": "string"
    },
    "counts": {
      "type": "object"
    },
    "agents": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "name",
          "kind",
          "domain",
          "batch"
        ],
        "properties": {
          "name": {
            "type": "string"
          },
          "kind": {
            "type": "string"
          },
          "domain": {
            "type": "string"
          },
          "batch": {
            "type": "integer"
          }
        }
      }
    },
    "skills": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "name",
          "kind",
          "domain",
          "batch"
        ],
        "properties": {
          "name": {
            "type": "string"
          },
          "kind": {
            "type": "string"
          },
          "domain": {
            "type": "string"
          },
          "batch": {
            "type": "integer"
          }
        }
      }
    }
  }
}
