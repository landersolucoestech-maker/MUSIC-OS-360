{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://engineering-os/contracts/pack-registry.schema.json",
  "title": "PackRegistry",
  "description": "Derived index of contract-governed pack items plus the manifest-declared supplemental definitions. The filesystem is never allowed to contain invisible operational dependencies.",
  "type": "object",
  "required": [
    "generatedFrom",
    "counts",
    "agents",
    "skills"
  ],
  "properties": {
    "generatedFrom": {
      "type": "string"
    },
    "counts": {
      "type": "object"
    },
    "agents": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "name",
          "kind",
          "domain",
          "batch"
        ],
        "properties": {
          "name": {
            "type": "string"
          },
          "kind": {
            "type": "string"
          },
          "domain": {
            "type": "string"
          },
          "batch": {
            "type": "integer"
          }
        }
      }
    },
    "skills": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "name",
          "kind",
          "domain",
          "batch"
        ],
        "properties": {
          "name": {
            "type": "string"
          },
          "kind": {
            "type": "string"
          },
          "domain": {
            "type": "string"
          },
          "batch": {
            "type": "integer"
          }
        }
      }
    },
    "supplementalDefinitions": {
      "type": "object",
      "required": [
        "agents",
        "skills"
      ],
      "properties": {
        "agents": {
          "type": "array",
          "items": {
            "type": "object"
          }
        },
        "skills": {
          "type": "array",
          "items": {
            "type": "object"
          }
        }
      }
    }
  }
}
