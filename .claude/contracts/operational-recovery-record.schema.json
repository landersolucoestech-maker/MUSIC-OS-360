{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://engineering-os/contracts/operational-recovery-record.schema.json",
  "title": "OperationalRecoveryRecord",
  "description": "Failure/recovery contract of an operational automation run, complementing failure-record (a failed gate fingerprint) and recovery-plan (a human-approved compensation plan). Names the failure fingerprint, the last good checkpoint, the chosen strategy and its compensating action; a rollback or compensation of a rights/share/financial/legal action always carries an approvalRef.",
  "type": "object",
  "required": [
    "id",
    "runId",
    "failureFingerprint",
    "strategy",
    "status",
    "createdAt"
  ],
  "properties": {
    "id": {
      "type": "string"
    },
    "runId": {
      "type": "string"
    },
    "failureFingerprint": {
      "type": "string"
    },
    "failedStep": {
      "type": "string"
    },
    "checkpointId": {
      "type": "string"
    },
    "strategy": {
      "enum": [
        "RETRY",
        "RESUME",
        "ROLLBACK",
        "COMPENSATE",
        "ESCALATE"
      ]
    },
    "attempts": {
      "type": "integer"
    },
    "compensatingAction": {
      "type": "string"
    },
    "approvalRef": {
      "type": "string"
    },
    "status": {
      "enum": [
        "OPEN",
        "IN_PROGRESS",
        "RECOVERED",
        "ESCALATED",
        "FAILED"
      ]
    },
    "createdAt": {
      "type": "string",
      "format": "date-time"
    },
    "resolvedAt": {
      "type": [
        "string",
        "null"
      ],
      "format": "date-time"
    }
  }
}
