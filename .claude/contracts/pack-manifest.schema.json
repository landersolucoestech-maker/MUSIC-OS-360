{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://engineering-os/contracts/pack-manifest.schema.json",
  "title": "PackManifest",
  "description": "Authoritative manifest of contract-governed pack items plus explicitly inventoried supplemental definitions that remain available to workflows/runtime. Supplemental definitions are visible dependencies, not implicit equivalents.",
  "type": "object",
  "required": [
    "name",
    "items",
    "supplementalDefinitions"
  ],
  "properties": {
    "name": {
      "type": "string"
    },
    "items": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "name",
          "type",
          "batch",
          "initialState",
          "finalState"
        ],
        "properties": {
          "name": {
            "type": "string"
          },
          "type": {
            "enum": [
              "agent",
              "skill"
            ]
          },
          "batch": {
            "type": "integer"
          },
          "initialState": {
            "enum": [
              "ABSENT",
              "EXISTING_VALID",
              "EXISTING_INCOMPLETE"
            ]
          },
          "finalState": {
            "enum": [
              "PENDING",
              "EXISTING_VALID",
              "ENHANCED",
              "CREATED",
              "BLOCKED_EXTERNAL"
            ]
          },
          "existingEquivalent": {
            "type": "string"
          },
          "file": {
            "type": "string"
          }
        }
      }
    },
    "supplementalDefinitions": {
      "type": "object",
      "required": [
        "agents",
        "skills"
      ],
      "properties": {
        "agents": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "name",
              "file"
            ],
            "properties": {
              "name": {
                "type": "string"
              },
              "file": {
                "type": "string"
              },
              "status": {
                "enum": [
                  "ACTIVE",
                  "COMPATIBILITY",
                  "DEPRECATED"
                ]
              }
            }
          }
        },
        "skills": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "name",
              "file"
            ],
            "properties": {
              "name": {
                "type": "string"
              },
              "file": {
                "type": "string"
              },
              "status": {
                "enum": [
                  "ACTIVE",
                  "ALIAS",
                  "COMPATIBILITY",
                  "DEPRECATED"
                ]
              },
              "canonical": {
                "type": "string"
              }
            }
          }
        }
      }
    }
  }
}
