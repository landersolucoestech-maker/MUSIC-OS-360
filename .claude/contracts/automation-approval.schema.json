{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://engineering-os/contracts/automation-approval.schema.json",
  "title": "AutomationApproval",
  "description": "Human-in-the-loop approval for a high-impact automation action. Extends approval-request (whose `action` is an action class of .claude/policies/authority.json) with the domain facts a human needs to decide: the subject entity, the exact change as before/after references, the impact categories (rights, shares, percentages, merge, deletion, signature, legal, payment, irreversible external send/publish, legal/financial auto-fix), the run that asked and an expiry. An automation resumes only on status GRANTED with a decider that is not the requesting agent.",
  "type": "object",
  "required": [
    "id",
    "runId",
    "actionClass",
    "subject",
    "change",
    "impact",
    "requestedBy",
    "status",
    "createdAt"
  ],
  "properties": {
    "id": {
      "type": "string"
    },
    "runId": {
      "type": "string"
    },
    "actionClass": {
      "type": "string"
    },
    "subject": {
      "type": "object",
      "required": [
        "entityType",
        "entityId"
      ],
      "properties": {
        "entityType": {
          "type": "string"
        },
        "entityId": {
          "type": "string"
        },
        "tenantId": {
          "type": "string"
        }
      }
    },
    "change": {
      "type": "object",
      "required": [
        "summary"
      ],
      "properties": {
        "summary": {
          "type": "string"
        },
        "beforeRef": {
          "type": "string"
        },
        "afterRef": {
          "type": "string"
        }
      }
    },
    "impact": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "requestedBy": {
      "type": "string"
    },
    "status": {
      "enum": [
        "PENDING",
        "GRANTED",
        "DENIED",
        "EXPIRED"
      ]
    },
    "decidedBy": {
      "type": [
        "string",
        "null"
      ]
    },
    "rationale": {
      "type": "string"
    },
    "evidenceRefs": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "expiresAt": {
      "type": [
        "string",
        "null"
      ],
      "format": "date-time"
    },
    "createdAt": {
      "type": "string",
      "format": "date-time"
    },
    "resolvedAt": {
      "type": [
        "string",
        "null"
      ],
      "format": "date-time"
    }
  }
}
