# ════════════════════════════════════════════════════════════════════════════════
# MUSIC OS 360 — LOCAL DEVELOPMENT env example (placeholders only, safe to version)
# Copy to .env.development (gitignored) and fill real values locally. Never commit it.
# ════════════════════════════════════════════════════════════════════════════════

NODE_ENV=development

# ── Dev-only bypass switches (NEVER set in staging/production) ────────────────
# Each of these makes the API refuse to boot when NODE_ENV is staging/production,
# and `verify:production-flags` fails the release if any is "true" there.
# AUTH_DISABLED=true is honored only when NODE_ENV is exactly "development".
AUTH_DISABLED=false
# DEV_SOCIAL_METRICS_MOCK: dev-only synthetic social metrics fallback (the only live mock flag).
# USE_MOCK is its deprecated alias (still honored, still forbidden in staging/production).
DEV_SOCIAL_METRICS_MOCK=false
# DEV_TENANT_ID / DEV_ORG_ID (optional, AUTH_DISABLED identity override) must be UUIDs.

# ── GET /api/v1/dev-auth/token (owner-token helper, OFF by default) ───────────
# The endpoint answers 404 unless DEV_AUTH_ENDPOINT_ENABLED is exactly "true", and
# always answers 403 in staging/production. When enabled, DEV_AUTH_EMAIL and
# DEV_AUTH_PASSWORD are REQUIRED (no built-in account); use a throw-away dev account.
DEV_AUTH_ENDPOINT_ENABLED=false
# DEV_AUTH_EMAIL=dev-owner@example.test
# DEV_AUTH_PASSWORD=<choose-a-strong-throwaway-password>

# Dev HS256 tokens (non-prod only) are signed with ENCRYPTION_KEY and are rejected when
# the key is the all-zero default or the token has no exp claim.
# ENCRYPTION_KEY=<64 hex chars, never all zeros>
