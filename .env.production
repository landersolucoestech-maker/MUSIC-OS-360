# ════════════════════════════════════════════════════════════════════════════════
# MUSIC OS 360 — PRODUCTION Environment Variables
# Placeholders apenas — nenhum valor real de produção é versionado aqui.
# Valores reais são injetados pelo mecanismo de deployment (CI/CD, plataforma),
# nunca preenchidos neste arquivo.
# NUNCA adicionar um secret real a este arquivo — ele é versionado no Git.
# Run: corepack pnpm env:check para validar configuração.
# ════════════════════════════════════════════════════════════════════════════════

# ── Ambiente ──────────────────────────────────────────────────────────────────
NODE_ENV=production
PORT=3001
DB_VERIFY_ENABLED=false

# ── PostgreSQL / Supabase ─────────────────────────────────────────────────────
# Direto (para migrations): postgres://postgres:SENHA@db.REF.supabase.co:5432/postgres
# Pooler (produção):        postgres://postgres.REF:SENHA@aws-0-sa-east-1.pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=1
DATABASE_URL=postgresql://<DB_USER>:<DB_PASSWORD>@<DB_HOST>:5432/<DB_NAME>

# Para migrations (sem pooler): mesmo que DATABASE_URL para projetos simples
DIRECT_DATABASE_URL=postgresql://<DB_USER>:<DB_PASSWORD>@<DB_HOST>:5432/<DB_NAME>

# Role de aplicação NOBYPASSRLS (obrigatória quando DATABASE_SESSION_CONTEXT_ENABLED=true)
APP_DATABASE_URL=postgresql://musicos_app:<DB_PASSWORD>@<DB_HOST>:6543/<DB_NAME>
# Deve ser declarada explicitamente como true em produção.
DATABASE_SESSION_CONTEXT_ENABLED=false

# ── Supabase Auth ─────────────────────────────────────────────────────────────
# Supabase Dashboard → Settings → API
SUPABASE_URL=https://<SUPABASE_URL>
SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.YOUR_ANON_KEY
SUPABASE_SERVICE_ROLE_KEY=<SUPABASE_SERVICE_ROLE_KEY>

# ── Criptografia (OBRIGATÓRIO — 64 hex chars = AES-256) ──────────────────────
# Gere: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ENCRYPTION_KEY=<ENCRYPTION_KEY>

# ── CORS ──────────────────────────────────────────────────────────────────────
CORS_ORIGINS=https://<PRODUCTION_FRONTEND_DOMAIN>

# ── URLs de aplicação ─────────────────────────────────────────────────────────
# Base para redirects pós-auth (convites, reset de senha, callbacks OAuth).
# Nunca aponta para localhost em produção.
FRONTEND_URL=https://<PRODUCTION_FRONTEND_DOMAIN>
APP_URL=https://<PRODUCTION_API_DOMAIN>
API_URL=https://<PRODUCTION_API_DOMAIN>/api/v1

# ── Redis (opcional — filas BullMQ) ──────────────────────────────────────────
# REDIS_QUEUE_URL é obrigatória em produção; REDIS_URL é opcional para cache distribuído
# Upstash: rediss://default:TOKEN@ENDPOINT:PORT
REDIS_QUEUE_URL=rediss://default:YOUR_TOKEN@YOUR_ENDPOINT:6379
REDIS_URL=redis://<REDIS_HOST>:6379

# RBAC observability. Do not set authority to ON before shadow readiness.
RBAC_PERSISTED_AUTHORITY=SHADOW
ALLOW_RBAC_SHADOW_IN_PRODUCTION=false
RBAC_DUAL_READ_TELEMETRY=true
RBAC_DISTRIBUTED_CACHE_ENABLED=true
RBAC_AUDIT_MIRROR_ENABLED=true
RBAC_DECISION_RETENTION_DAYS=30
RBAC_DECISION_RETENTION_INTERVAL_HOURS=6

# ── Stripe Billing ────────────────────────────────────────────────────────────
STRIPE_SECRET_KEY=<STRIPE_SECRET_KEY>
STRIPE_WEBHOOK_SECRET=<STRIPE_WEBHOOK_SECRET>
STRIPE_CONNECT_CLIENT_ID=ca_YOUR_CONNECT_CLIENT_ID

# ── Sentry (opcional — observabilidade) ──────────────────────────────────────
SENTRY_DSN=<SENTRY_DSN>
SENTRY_RELEASE=0.0.1

# ── Cloudflare R2 / Storage ───────────────────────────────────────────────────
R2_ACCOUNT_ID=your_cloudflare_account_id
R2_ACCESS_KEY=<R2_ACCESS_KEY>
R2_SECRET_KEY=<R2_SECRET_KEY>
R2_BUCKET_NAME=musicos360
R2_PUBLIC_URL=https://<R2_PUBLIC_URL>

# ── IA Providers ──────────────────────────────────────────────────────────────
ANTHROPIC_API_KEY=<ANTHROPIC_API_KEY>
OPENAI_API_KEY=<OPENAI_API_KEY>
OPENAI_BASE_URL=
GOOGLE_AI_API_KEY=<GOOGLE_AI_API_KEY>

# ── Email (Resend) ────────────────────────────────────────────────────────────
RESEND_API_KEY=<RESEND_API_KEY>
RESEND_FROM_EMAIL=noreply@musicos360.com.br

# ── Integrações de Música ──────────────────────────────────────────────────────
# Deezer usa API pública sem chave — nenhuma variável necessária.
ACRCLOUD_HOST=https://<ACRCLOUD_HOST>
ACRCLOUD_ACCESS_KEY=<ACRCLOUD_ACCESS_KEY>
ACRCLOUD_ACCESS_SECRET=<ACRCLOUD_ACCESS_SECRET>
SPOTIFY_CLIENT_ID=YOUR_SPOTIFY_CLIENT_ID
SPOTIFY_CLIENT_SECRET=<SPOTIFY_CLIENT_SECRET>
SPOTIFY_REDIRECT_URI=https://<APP_URL>/api/v1/integrations/spotify/callback
SPOTIFY_OAUTH_STATE_SECRET=<SPOTIFY_OAUTH_STATE_SECRET>
YOUTUBE_API_KEY=<YOUTUBE_API_KEY>
META_APP_ID=<META_APP_ID>
META_APP_SECRET=<META_APP_SECRET>
META_REDIRECT_URI=https://<APP_URL>/api/v1/integrations/instagram/callback
TIKTOK_CLIENT_KEY=<TIKTOK_CLIENT_KEY>
TIKTOK_CLIENT_SECRET=<TIKTOK_CLIENT_SECRET>
TIKTOK_REDIRECT_URI=https://<APP_URL>/api/v1/integrations/tiktok/callback
SOUNDCLOUD_CLIENT_ID=<SOUNDCLOUD_CLIENT_ID>
GOOGLE_CLIENT_ID=<GOOGLE_CLIENT_ID>
GOOGLE_CLIENT_SECRET=<GOOGLE_CLIENT_SECRET>
GOOGLE_ADS_CLIENT_ID=<GOOGLE_ADS_CLIENT_ID>
GOOGLE_ADS_CLIENT_SECRET=<GOOGLE_ADS_CLIENT_SECRET>
GOOGLE_ADS_REDIRECT_URI=https://<APP_URL>/api/v1/integrations/google-ads/callback

# ── PostHog (analytics) ───────────────────────────────────────────────────────
POSTHOG_API_KEY=<POSTHOG_API_KEY>
POSTHOG_HOST=https://<POSTHOG_HOST>

# ── Assinatura Digital (Autentique) ───────────────────────────────────────────
AUTENTIQUE_WEBHOOK_SECRET=<AUTENTIQUE_WEBHOOK_SECRET>

# ── DocuSign OAuth ────────────────────────────────────────────────────────────
DOCUSIGN_INTEGRATION_KEY=YOUR_DOCUSIGN_INTEGRATION_KEY
DOCUSIGN_CLIENT_SECRET=<DOCUSIGN_CLIENT_SECRET>
DOCUSIGN_AUTH_BASE_URL=https://<DOCUSIGN_AUTH_BASE_URL>

# ── Seeds ─────────────────────────────────────────────────────────────────────
# UUID do usuário Supabase Auth (Authentication → Users no Dashboard)
SEED_ADMIN_SUB=00000000-0000-0000-0000-000000000000
SEED_ADMIN_EMAIL=admin@example.com
SEED_ADMIN_NAME=Admin Demo
SEED_ORG_NAME=MUSIC OS 360 Demo
SEED_ORG_SLUG=musicos360-demo

# ── Dev-only bypass flags (BLOQUEADOS EM PRODUÇÃO) ───────────────────────────
# MOCK_MODE/VITE_MOCK_MODE/VITE_USE_MOCK were dead flags and were removed.
USE_MOCK=false
AUTH_DISABLED=false
