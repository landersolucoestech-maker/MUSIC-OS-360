# ════════════════════════════════════════════════════════════════════════════════
# MUSIC OS 360 — PRODUCTION Environment Variables
# Placeholders only — no real production value is versioned here.
# Real values are injected by the deployment mechanism (CI/CD, platform),
# never filled in this file.
# NEVER add a real secret to this file — it is versioned in Git.
# Run: corepack pnpm env:check to validate the configuration.
# ════════════════════════════════════════════════════════════════════════════════

# ── Environment ──────────────────────────────────────────────────────────────────
NODE_ENV=production
PORT=3001
DB_VERIFY_ENABLED=false

# ── PostgreSQL / Supabase ─────────────────────────────────────────────────────
# Direct (for migrations): postgres://postgres:SENHA@db.REF.supabase.co:5432/postgres
# Pooler (production):        postgres://postgres.REF:SENHA@aws-0-sa-east-1.pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=1
DATABASE_URL=postgresql://<DB_USER>:<DB_PASSWORD>@<DB_HOST>:5432/<DB_NAME>

# For migrations (no pooler): same as DATABASE_URL for simple projects
DIRECT_DATABASE_URL=postgresql://<DB_USER>:<DB_PASSWORD>@<DB_HOST>:5432/<DB_NAME>

# Application role NOBYPASSRLS (required when DATABASE_SESSION_CONTEXT_ENABLED=true)
APP_DATABASE_URL=postgresql://musicos_app:<DB_PASSWORD>@<DB_HOST>:6543/<DB_NAME>
# Must be declared explicitly as true in production.
DATABASE_SESSION_CONTEXT_ENABLED=false

# ── Supabase Auth ─────────────────────────────────────────────────────────────
# Supabase Dashboard → Settings → API
SUPABASE_URL=https://<SUPABASE_URL>
SUPABASE_ANON_KEY=<SUPABASE_ANON_KEY>
SUPABASE_SERVICE_ROLE_KEY=<SUPABASE_SERVICE_ROLE_KEY>

# ── Encryption (REQUIRED — 64 hex chars = AES-256) ──────────────────────
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ENCRYPTION_KEY=<ENCRYPTION_KEY>

# ── CORS ──────────────────────────────────────────────────────────────────────
CORS_ORIGINS=https://<PRODUCTION_FRONTEND_DOMAIN>

# ── Application URLs ─────────────────────────────────────────────────────────
# Base for post-auth redirects (invitations, password reset, OAuth callbacks).
# Never points to localhost in production.
FRONTEND_URL=https://<PRODUCTION_FRONTEND_DOMAIN>
APP_URL=https://<PRODUCTION_API_DOMAIN>
API_URL=https://<PRODUCTION_API_DOMAIN>/api/v1

# ── Redis (optional — BullMQ queues) ──────────────────────────────────────────
# REDIS_QUEUE_URL is required in production; REDIS_URL is optional for the distributed cache
# Upstash: rediss://default:TOKEN@ENDPOINT:PORT
REDIS_QUEUE_URL=rediss://<REDIS_USER>:<REDIS_PASSWORD>@<REDIS_HOST>:6379
REDIS_URL=redis://<REDIS_HOST>:6379

# RBAC observability. Do not set authority to ON before shadow readiness.
RBAC_PERSISTED_AUTHORITY=SHADOW
ALLOW_RBAC_SHADOW_IN_PRODUCTION=false
RBAC_DUAL_READ_TELEMETRY=true
RBAC_DISTRIBUTED_CACHE_ENABLED=true
RBAC_AUDIT_MIRROR_ENABLED=true
RBAC_DECISION_RETENTION_DAYS=30
RBAC_DECISION_RETENTION_INTERVAL_HOURS=6

# ── Stripe Billing ────────────────────────────────────────────────────────────
STRIPE_SECRET_KEY=<STRIPE_SECRET_KEY>
STRIPE_WEBHOOK_SECRET=<STRIPE_WEBHOOK_SECRET>
STRIPE_CONNECT_CLIENT_ID=<STRIPE_CONNECT_CLIENT_ID>

# ── Sentry (optional — observability) ──────────────────────────────────────
SENTRY_DSN=<SENTRY_DSN>
SENTRY_RELEASE=0.0.1

# ── Cloudflare R2 / Storage ───────────────────────────────────────────────────
R2_ACCOUNT_ID=<R2_ACCOUNT_ID>
R2_ACCESS_KEY=<R2_ACCESS_KEY>
R2_SECRET_KEY=<R2_SECRET_KEY>
R2_BUCKET_NAME=musicos360
R2_PUBLIC_URL=https://<R2_PUBLIC_URL>

# ── AI Providers ──────────────────────────────────────────────────────────────
ANTHROPIC_API_KEY=<ANTHROPIC_API_KEY>
OPENAI_API_KEY=<OPENAI_API_KEY>
GOOGLE_AI_API_KEY=<GOOGLE_AI_API_KEY>

# ── Email (Resend) ────────────────────────────────────────────────────────────
RESEND_API_KEY=<RESEND_API_KEY>
RESEND_FROM_EMAIL=noreply@musicos360.com.br

# ── Music Integrations ──────────────────────────────────────────────────────
# Deezer uses a public API without a key — no variable needed.
ACRCLOUD_HOST=https://<ACRCLOUD_HOST>
ACRCLOUD_ACCESS_KEY=<ACRCLOUD_ACCESS_KEY>
ACRCLOUD_ACCESS_SECRET=<ACRCLOUD_ACCESS_SECRET>
SPOTIFY_CLIENT_ID=<SPOTIFY_CLIENT_ID>
SPOTIFY_CLIENT_SECRET=<SPOTIFY_CLIENT_SECRET>
SPOTIFY_REDIRECT_URI=https://<APP_URL>/api/v1/integrations/spotify/callback
SPOTIFY_OAUTH_STATE_SECRET=<SPOTIFY_OAUTH_STATE_SECRET>
YOUTUBE_API_KEY=<YOUTUBE_API_KEY>
META_APP_ID=<META_APP_ID>
META_APP_SECRET=<META_APP_SECRET>
META_REDIRECT_URI=https://<APP_URL>/api/v1/integrations/instagram/callback
TIKTOK_CLIENT_KEY=<TIKTOK_CLIENT_KEY>
TIKTOK_CLIENT_SECRET=<TIKTOK_CLIENT_SECRET>
TIKTOK_REDIRECT_URI=https://<APP_URL>/api/v1/integrations/tiktok/callback
SOUNDCLOUD_CLIENT_ID=<SOUNDCLOUD_CLIENT_ID>
GOOGLE_CLIENT_ID=<GOOGLE_CLIENT_ID>
GOOGLE_CLIENT_SECRET=<GOOGLE_CLIENT_SECRET>
GOOGLE_ADS_CLIENT_ID=<GOOGLE_ADS_CLIENT_ID>
GOOGLE_ADS_CLIENT_SECRET=<GOOGLE_ADS_CLIENT_SECRET>
GOOGLE_ADS_REDIRECT_URI=https://<APP_URL>/api/v1/integrations/google-ads/callback

# ── PostHog (analytics) ───────────────────────────────────────────────────────
POSTHOG_API_KEY=<POSTHOG_API_KEY>
POSTHOG_HOST=https://<POSTHOG_HOST>

# ── Digital Signature (Autentique) ───────────────────────────────────────────
AUTENTIQUE_WEBHOOK_SECRET=<AUTENTIQUE_WEBHOOK_SECRET>

# ── DocuSign OAuth ────────────────────────────────────────────────────────────
DOCUSIGN_INTEGRATION_KEY=<DOCUSIGN_INTEGRATION_KEY>
DOCUSIGN_CLIENT_SECRET=<DOCUSIGN_CLIENT_SECRET>
DOCUSIGN_AUTH_BASE_URL=https://<DOCUSIGN_AUTH_BASE_URL>

# ── Seeds ─────────────────────────────────────────────────────────────────────
# UUID of the Supabase Auth user (Authentication → Users in the Dashboard)
SEED_ADMIN_SUB=<SEED_ADMIN_SUB>
SEED_ADMIN_EMAIL=<SEED_ADMIN_EMAIL>
SEED_ADMIN_NAME=<SEED_ADMIN_NAME>
SEED_ORG_NAME=<SEED_ORG_NAME>
SEED_ORG_SLUG=<SEED_ORG_SLUG>

# ── Dev-only bypass flags (BLOCKED IN PRODUCTION) ───────────────────────────
# MOCK_MODE/VITE_MOCK_MODE/VITE_USE_MOCK were dead flags and were removed.
DEV_SOCIAL_METRICS_MOCK=false
USE_MOCK=false
AUTH_DISABLED=false
