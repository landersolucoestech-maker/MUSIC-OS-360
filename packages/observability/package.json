{
  "name": "@music-os-360/observability",
  "version": "0.0.1",
  "description": "MUSIC OS 360 — Unified Sentry, OpenTelemetry and Pino logger",
  "private": true,
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./sentry": "./src/sentry.ts",
    "./logger": "./src/logger.ts",
    "./otel": "./src/otel.ts"
  },
  "scripts": {
    "typecheck": "tsc --noEmit"
  },
  "peerDependencies": {
    "@sentry/node": ">=8",
    "@sentry/react": ">=8"
  },
  "peerDependenciesOptional": {
    "@sentry/node": true,
    "@sentry/react": true
  },
  "devDependencies": {
    "typescript": "^5.8.3"
  }
}
